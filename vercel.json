{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/mt-relay/static/:path*", "destination": "https://us-assets.i.posthog.com/static/:path*" },
    { "source": "/mt-relay/array/:path*", "destination": "https://us-assets.i.posthog.com/array/:path*" },
    { "source": "/mt-relay/:path*", "destination": "https://us.i.posthog.com/:path*" },
    { "source": "/", "destination": "/index.html" },
    { "source": "/install", "destination": "/install.sh" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/u/:slug(burn-[A-Za-z0-9-]+)", "destination": "/api/burn?slug=:slug" },
    { "source": "/s/:t([a-f0-9]+)", "destination": "/api/s?t=:t" }
  ],
  "crons": [
    { "path": "/api/gc", "schedule": "0 3 * * *" }
  ]
}
